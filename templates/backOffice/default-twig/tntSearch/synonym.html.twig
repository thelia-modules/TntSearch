{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Manage Synonyms'|trans({}, 'tntsearch') }}{% endblock %}

{% block content %}
    <div id="tntsearch-synonym"
         data-save-url="{{ path('synonym_save_synonym') }}"
         data-token="{{ form._token.vars.value }}">
        {% if success %}
            <div class="alert alert-success alert-dismissible" role="alert">
                {{ success }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endif %}
        {% if error %}
            <div class="alert alert-danger alert-dismissible" role="alert">
                {{ error }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endif %}

        <div class="mb-4">
            <a href="#add_synonym_dialog" data-bs-toggle="modal" data-bs-target="#add_synonym_dialog" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> {{ 'Add New Synonym Group'|trans({}, 'tntsearch') }}
            </a>
        </div>

        <div class="card mb-3">
            <div class="card-header">{{ 'Existing Synonym Groups'|trans({}, 'tntsearch') }}</div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        {% if synonymGroups|length > 0 %}
                            <thead>
                            <tr>
                                <th>{{ 'ID'|trans({}, 'tntsearch') }}</th>
                                <th>{{ 'Terms'|trans({}, 'tntsearch') }}</th>
                                <th>{{ 'Status'|trans({}, 'tntsearch') }}</th>
                                <th class="text-end">{{ 'Actions'|trans({}, 'tntsearch') }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for group in synonymGroups %}
                                <tr data-group-id="{{ group.group_id }}">
                                    <td><strong>{{ group.group_id }}</strong></td>
                                    <td>
                                        <div class="synonym-terms-display">
                                            <small>{{ group.terms|join(',') }}</small>
                                        </div>
                                        <input type="text" class="form-control synonym-terms-input d-none"
                                               value="{{ group.terms|join(',') }}">
                                    </td>
                                    <td>
                                        {% if group.enabled %}
                                            <span class="badge text-bg-success">{{ 'Enabled'|trans({}, 'tntsearch') }}</span>
                                        {% else %}
                                            <span class="badge text-bg-danger">{{ 'Disabled'|trans({}, 'tntsearch') }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-warning synonym-edit"
                                                title="{{ 'Edit'|trans({}, 'tntsearch') }}">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-success synonym-save d-none"
                                                data-group-id="{{ group.group_id }}"
                                                title="{{ 'Save'|trans({}, 'tntsearch') }}">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-secondary synonym-cancel d-none"
                                                title="{{ 'Cancel'|trans({}, 'tntsearch') }}">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                        <a href="#delete_synonym_dialog" data-bs-toggle="modal" data-bs-target="#delete_synonym_dialog"
                                           data-id="{{ group.group_id }}" class="btn btn-sm btn-danger synonym-delete"
                                           title="{{ 'Delete'|trans({}, 'tntsearch') }}">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        {% else %}
                            <tbody>
                            <tr>
                                <td colspan="4">
                                    <div class="alert alert-info mb-0">
                                        {{ 'No synonym groups found. Create your first group!'|trans({}, 'tntsearch') }}
                                    </div>
                                </td>
                            </tr>
                            </tbody>
                        {% endif %}
                    </table>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <div class="alert alert-info">
                    <p>{{ 'Click the button below to immediately generate search indexes. It may take some time...'|trans({}, 'tntsearch') }}</p>
                </div>
                <a href="{{ path('tntsearch_indexation_generation') }}" class="btn btn-danger">{{ 'Generate indexes'|trans({}, 'tntsearch') }}</a>
            </div>
        </div>

        {# -- Add synonym modal -- #}
        <div class="modal fade" id="add_synonym_dialog" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form method="post" action="{{ path('synonym_save_synonym') }}">
                        {{ form_widget(form._token) }}
                        <div class="modal-header">
                            <h5 class="modal-title">{{ 'Add New Synonym Group'|trans({}, 'tntsearch') }}</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                {{ form_label(form.terms) }}
                                {{ form_widget(form.terms, {'attr': {'placeholder': 'e.g., red, rouge, crimson, scarlet'|trans({}, 'tntsearch')}}) }}
                                {{ form_errors(form.terms) }}
                                <div class="form-text">{{ 'Enter words separated by commas'|trans({}, 'tntsearch') }}</div>
                            </div>
                            {{ form_rest(form) }}
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans({}, 'tntsearch') }}</button>
                            <button type="submit" class="btn btn-primary">{{ 'Save'|trans({}, 'tntsearch') }}</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        {# -- Delete synonym modal -- #}
        <div class="modal fade" id="delete_synonym_dialog" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form method="post" action="{{ path('synonym_delete_synonym') }}">
                        <input type="hidden" name="_token" value="{{ assignToken() }}">
                        <input type="hidden" name="group_id" class="synonym-delete-id" value="">
                        <div class="modal-header">
                            <h5 class="modal-title">{{ 'Delete Synonym Group'|trans({}, 'tntsearch') }}</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            {{ 'Do you really want to delete this synonym group?'|trans({}, 'tntsearch') }}
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans({}, 'tntsearch') }}</button>
                            <button type="submit" class="btn btn-danger">{{ 'Delete'|trans({}, 'tntsearch') }}</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts_extra %}
    <script>
        (function () {
            const root = document.getElementById('tntsearch-synonym');
            if (!root) {
                return;
            }
            const saveUrl = root.dataset.saveUrl;
            const token = root.dataset.token;

            function showAlert(message, type) {
                root.querySelectorAll('.alert-ajax').forEach((el) => el.remove());
                const alert = document.createElement('div');
                alert.className = 'alert alert-' + (type === 'success' ? 'success' : 'danger') + ' alert-dismissible alert-ajax';
                alert.setAttribute('role', 'alert');
                alert.innerHTML = message + '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>';
                root.prepend(alert);
                if (type === 'success') {
                    setTimeout(() => alert.remove(), 3000);
                }
            }

            root.addEventListener('click', (ev) => {
                const editBtn = ev.target.closest('.synonym-edit');
                if (editBtn) {
                    const row = editBtn.closest('tr');
                    row.querySelector('.synonym-terms-display').classList.add('d-none');
                    row.querySelector('.synonym-terms-input').classList.remove('d-none');
                    row.querySelector('.synonym-edit').classList.add('d-none');
                    row.querySelector('.synonym-save').classList.remove('d-none');
                    row.querySelector('.synonym-cancel').classList.remove('d-none');
                    return;
                }

                const cancelBtn = ev.target.closest('.synonym-cancel');
                if (cancelBtn) {
                    const row = cancelBtn.closest('tr');
                    row.querySelector('.synonym-terms-input').classList.add('d-none');
                    row.querySelector('.synonym-terms-display').classList.remove('d-none');
                    row.querySelector('.synonym-save').classList.add('d-none');
                    row.querySelector('.synonym-cancel').classList.add('d-none');
                    row.querySelector('.synonym-edit').classList.remove('d-none');
                    root.querySelectorAll('.alert-ajax').forEach((el) => el.remove());
                    return;
                }

                const saveBtn = ev.target.closest('.synonym-save');
                if (saveBtn) {
                    const row = saveBtn.closest('tr');
                    const groupId = saveBtn.dataset.groupId;
                    const terms = row.querySelector('.synonym-terms-input').value;
                    const body = new URLSearchParams();
                    body.append('synonym_form[group_id]', groupId);
                    body.append('synonym_form[terms]', terms);
                    body.append('synonym_form[_token]', token);

                    fetch(saveUrl, {
                        method: 'POST',
                        headers: {'X-Requested-With': 'XMLHttpRequest'},
                        body: body,
                    }).then((response) => {
                        if (!response.ok) {
                            throw new Error('save failed');
                        }
                        row.querySelector('.synonym-terms-display small').textContent = terms;
                        row.querySelector('.synonym-terms-input').classList.add('d-none');
                        row.querySelector('.synonym-terms-display').classList.remove('d-none');
                        row.querySelector('.synonym-save').classList.add('d-none');
                        row.querySelector('.synonym-cancel').classList.add('d-none');
                        row.querySelector('.synonym-edit').classList.remove('d-none');
                        showAlert({{ 'Synonyms updated successfully!'|trans({}, 'tntsearch')|json_encode|raw }}, 'success');
                    }).catch(() => {
                        showAlert({{ 'Error while updating synonyms'|trans({}, 'tntsearch')|json_encode|raw }}, 'error');
                    });
                    return;
                }

                const deleteBtn = ev.target.closest('.synonym-delete');
                if (deleteBtn) {
                    const input = root.querySelector('.synonym-delete-id');
                    if (input) {
                        input.value = deleteBtn.dataset.id;
                    }
                }
            });
        })();
    </script>
    {{ safe_hook('synonym.js') }}
{% endblock %}
