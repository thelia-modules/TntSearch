{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Search log'|trans({}, 'tntsearch') }}{% endblock %}

{% block content %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/admin/home">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Search log'|trans({}, 'tntsearch') }}</li>
        </ol>
    </nav>

    <div class="card">
        <div class="card-header">{{ 'Search log'|trans({}, 'tntsearch') }}</div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                    <tr>
                        <th>{{ 'Search words'|trans({}, 'tntsearch') }}</th>
                        <th>{{ 'index'|trans({}, 'tntsearch') }}</th>
                        <th>{{ 'lang'|trans({}, 'tntsearch') }}</th>
                        <th>{{ 'Number Hits'|trans({}, 'tntsearch') }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for row in searchLogs %}
                        <tr>
                            <td>{{ row.SearchWords }}</td>
                            <td>{{ row.Index }}</td>
                            <td>{{ row.Locale }}</td>
                            <td>{{ row.NumHits }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4">
                                <div class="alert alert-info mb-0">{{ 'No search log found.'|trans({}, 'tntsearch') }}</div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {{ safe_hook('search.bottom') }}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('search.js') }}
{% endblock %}
