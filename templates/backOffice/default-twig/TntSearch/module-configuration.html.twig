{# TntSearch back-office configuration (module.configuration hook fragment) #}
{% if app.request.query.get('success') %}
    <div class="alert alert-success" role="status">{{ 'The indexes were rebuilt.'|trans({}, 'tntsearch') }}</div>
{% elseif app.request.query.get('error') %}
    <div class="alert alert-danger" role="alert">{{ 'The indexes could not be rebuilt. The cause is written in the Thelia log.'|trans({}, 'tntsearch') }}</div>
{% endif %}

<div class="card mb-3">
    <div class="card-body">
        <form method="post" action="{{ path('tntsearch_configuration__on_the_fly') }}">
            <input type="hidden" name="_token" value="{{ assignToken() }}">
            <div class="alert alert-info">
                <p>{{ 'Thelia indexes the products, categories, contents, folders and brands each time they are saved: this option does not change that.'|trans({}, 'tntsearch') }}</p>
                <p class="mb-0">{{ 'It only concerns the customer index of the module. When the box is unchecked, that index is only updated when the indexes are rebuilt (button below, or the <code>bin/console tntsearch:indexes</code> command).'|trans({}, 'tntsearch')|raw }}</p>
            </div>
            <div class="mb-3 form-check">
                <input type="checkbox" class="form-check-input" id="on-the-fly-update" name="on-the-fly-update" value="1" {{ on_the_fly_update ? 'checked' : '' }}>
                <label class="form-check-label" for="on-the-fly-update">{{ 'Update the customer index each time a customer account is saved'|trans({}, 'tntsearch') }}</label>
            </div>

            <button type="submit" class="btn btn-primary">{{ 'Update'|trans }}</button>
        </form>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="alert alert-info">
            <p class="mb-0">{{ 'Rebuilds every index of the module: customers, orders, then the catalogue in each language. On a large catalogue, prefer the <code>bin/console thelia:search:reindex</code> command, which works in batches and resumes after an interruption.'|trans({}, 'tntsearch')|raw }}</p>
        </div>

        <form method="post" class="d-inline" action="{{ path('tntsearch_indexation_generation') }}">
            <input type="hidden" name="_token" value="{{ assignToken() }}">
            <button type="submit" class="btn btn-danger">{{ 'Rebuild the indexes'|trans({}, 'tntsearch') }}</button>
        </form>
    </div>
</div>
